#include <iostream>
using namespace std;

class Parallelepiped {
private:
    double a, b, c;

public:
    Parallelepiped(double x, double y, double z) {
        a = x;
        b = y;
        c = z;
        cout << "Object created!" << endl;
    }

    ~Parallelepiped() {
        cout << "Object destroyed!" << endl;
    }

    double lateralArea() {
        return 2 * c * (a + b);
    }

    double volume() {
        return a * b * c;
    }
};

int main() {
    double a, b, c;

    cout << "Enter the first edge: ";
    cin >> a;

    cout << "Enter the second edge: ";
    cin >> b;

    cout << "Enter the third edge: ";
    cin >> c;

    if (a <= 0 || b <= 0 || c <= 0) {
        cout << "Error! Edge lengths must be positive." << endl;
        return 0;
    }

    Parallelepiped figure(a, b, c);

    cout << "\nLateral surface area: " << figure.lateralArea() << endl;
    cout << "Volume: " << figure.volume() << endl;

    return 0;
}
